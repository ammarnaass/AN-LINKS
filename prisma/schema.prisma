datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  username      String       @unique
  role          String       @default("USER")
  emailVerified DateTime?
  isSuspended   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  profile       Profile?
  links         Link[]
  socials       SocialLink[]
  sessions      UserSession[]
  subscriptions UserSubscription[]
  invoices      FinancialInvoice[]
  auditLogs     FinancialAuditLog[]
  payoutProfile     CreatorPayoutProfile?
  payoutRequests    PayoutRequest[]
  twoFactorAuth     UserTwoFactorAuth?
  securityAuditLogs SecurityAuditLog[]
  nfcCard           NfcCard?
  referralCode      String?      @unique
  referredById      String?
  referredBy        User?        @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]       @relation("UserReferrals")
  consultations     ConsultationService[]
  availabilityRules AvailabilityRule[]
  appointmentBookings AppointmentBooking[]
  webhookEndpoints  CreatorWebhookEndpoint[]
  referrerCommissions AffiliateCommissionLog[] @relation("ReferrerCommissions")
  referredCommissions AffiliateCommissionLog[] @relation("ReferredUserCommissions")
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  bio              String?
  avatarUrl        String?
  phone            String?
  location         String?
  seoIndexing      Boolean  @default(true)
  themeKey         String   @default("layanDark")
  accentColor      String   @default("#4edea3")
  buttonStyle      String   @default("filled")
  borderRadius     String   @default("rounded-xl")
  font             String   @default("Cairo")
  backgroundType   String   @default("THEME")
  customBackground String?
  buttonShadow     String   @default("none")
  socialPosition   String   @default("top")
  cardStyle        String   @default("glass")
  bgOverlayOpacity Int      @default(40)
  isPublished      Boolean  @default(true)
  metaPixelId       String?
  tiktokPixelId     String?
  googleAnalyticsId String?
  snapchatPixelId   String?
  customDomain            String?   @unique
  domainVerified          Boolean   @default(false)
  domainVerificationToken String?
  domainVerifiedAt        DateTime?

  // Avatar Frame & Border Customization
  avatarFrameShape   String   @default("circle")
  avatarBorderWidth  String   @default("2")
  avatarBorderColor  String?

  // Profile Badge Customization
  badgeEnabled       Boolean  @default(true)
  badgeShape         String   @default("circle")
  badgeSize          String   @default("md")
  badgeColor         String?
  badgeIcon          String   @default("CheckCircle2")

  // Newsletter Customization
  newsletterEnabled    Boolean  @default(true)
  newsletterTitle      String?
  newsletterSubtitle   String?
  newsletterButtonText String?
  welcomeSubject       String?
  welcomeBody          String?
  welcomeGiftUrl       String?
}

enum PlatformCategory {
  SOCIAL
  VIDEO
  MESSAGING
  COMMERCE
  DEV
  MUSIC
  PROFESSIONAL
  CUSTOM
}

model Platform {
  id              String            @id @default(cuid())
  slug            String            @unique // youtube, tiktok, x, instagram, salla, zid...
  nameAr          String            // يوتيوب، تيك توك، سلة...
  nameEn          String            // YouTube, TikTok, Salla...
  category        PlatformCategory  @default(SOCIAL)
  defaultIcon     String            // Lucide icon identifier (e.g. "youtube", "shopping-bag")
  brandColor      String            // e.g. #FF0000, #000000, #E1306C, #00B4D8
  domainPattern   String            // Pipe-separated domains: "youtube.com|youtu.be"
  urlPlaceholder  String            // e.g. "https://youtube.com/@channel"
  isEnabled       Boolean           @default(true) // Controls visibility in creator studio
  isVerified      Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  links           Link[]
  socialLinks     SocialLink[]
  clicks          LinkClick[]

  @@index([category, isEnabled])
  @@index([sortOrder])
}

model Link {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId  String?
  platform    Platform?       @relation(fields: [platformId], references: [id], onDelete: SetNull)
  type        String          @default("LINK") // LINK | HEADER | YOUTUBE | SPOTIFY
  title       String
  url         String
  icon        String?
  description String?
  position    Int             @default(0)
  isActive    Boolean         @default(true)
  isPinned    Boolean         @default(false)
  isArchived  Boolean         @default(false)
  clicksCount       Int             @default(0) // عداد إجمالي تراكمي سريع للنقرات
  thumbnailUrl      String?
  customBgColor     String?
  customTextColor   String?
  customBorderColor String?
  customShadow      String?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  pinCode           String?
  isSensitive       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  clicks      LinkClick[]
  stats       DailyLinkStat[]

  @@index([userId, position])
  @@index([platformId])
  @@index([isActive, isArchived])
}

model SocialLink {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId  String?
  platform    Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  network     String
  url         String
  position    Int       @default(0)

  @@index([userId, position])
  @@index([platformId])
}

model LinkClick {
  id          String    @id @default(cuid())
  linkId      String
  link        Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  platformId  String?
  platform    Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  country     String?   // SA, AE, EG, US...
  city        String?
  device      String?   // MOBILE, DESKTOP, TABLET, UNKNOWN
  browser     String?   // Chrome, Safari, Firefox, Edge, Other
  os          String?   // iOS, Android, Windows, macOS, Linux, Other
  referer     String?
  createdAt   DateTime  @default(now())

  @@index([linkId, createdAt])
  @@index([platformId, createdAt])
  @@index([device])
  @@index([country])
  @@index([createdAt])
}

model DailyLinkStat {
  id      String   @id @default(cuid())
  linkId  String
  link    Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  clicks  Int      @default(0)

  @@unique([linkId, date])
}

model DailyProfileStat {
  id        String   @id @default(cuid())
  username  String
  date      DateTime @db.Date
  views     Int      @default(0)

  @@unique([username, date])
}

model Report {
  id          String   @id @default(cuid())
  username    String
  reason      String
  details     String?
  reporterIp  String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  deviceType   String   @default("desktop")
  browser      String?
  os           String?
  isActive     Boolean  @default(true)
  lastActive   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId, isActive])
}

// ==========================================
// Financial & Subscription Management Models
// ==========================================

model PaymentGateway {
  id                  String   @id @default(cuid())
  code                String   @unique // mada, apple_pay, stc_pay, tamara, tabby, stripe, paypal, fawry
  nameAr              String
  nameEn              String
  category            String   // NATIONAL | INTERNATIONAL | BNPL | WALLET
  isEnabled           Boolean  @default(false)
  isTestMode          Boolean  @default(true)
  publishableKey      String?
  secretKeyEncrypted  String?  // مشفر في قاعدة البيانات
  webhookSecret       String?
  feePercentage       Float    @default(0.0) // عمولة البوابة المقتطعة
  feeFixed            Float    @default(0.0) // رسوم ثابتة لكل عملية
  supportedCurrencies String[] // ["SAR", "AED", "USD", ...]
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SubscriptionPlan {
  id             String              @id @default(cuid())
  slug           String              @unique // free, creator, pro, agency
  nameAr         String
  nameEn         String
  descriptionAr  String?
  badgeAr        String?             // "الأكثر شعبية", "عرض خاص"
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  prices         PlanPrice[]
  quotas         PlanQuota?
  subscriptions  UserSubscription[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PlanPrice {
  id              String           @id @default(cuid())
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currency        String           // SAR, AED, USD, EGP, KWD
  billingCycle    String           // MONTHLY, YEARLY, LIFETIME
  amount          Float            // المبلغ الفعلي للدفع
  originalAmount  Float?           // المبلغ قبل الخصم (لإظهار الشطب والتوفير)
  isActive        Boolean          @default(true)
  externalPriceId String?          // المعرف المرتبط في Stripe أو Moyasar
  
  @@unique([planId, currency, billingCycle])
}

model PlanQuota {
  id                     String           @id @default(cuid())
  planId                 String           @unique
  plan                   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  maxLinks               Int              @default(10) // عدد الروابط المسموحة
  allowCustomDomain      Boolean          @default(false) // ربط دومين خاص
  allowRemoveBranding    Boolean          @default(false) // إخفاء شعار المنصة
  allowAdvancedThemes    Boolean          @default(false) // قوالب CSS وخلفيات الفيديو
  allowDetailedAnalytics Boolean          @default(false) // إحصائيات دقيقة ومصادر الزيارات
  allowPrioritySupport   Boolean          @default(false) // دعم فني مخصص
  customCssAllowed       Boolean          @default(false)
  storeCommissionRate    Float            @default(5.0) // نسبة عمولة المنصة من مبيعات المتجر الرقمي للمستخدم
  allowAppointments      Boolean          @default(false)
  allowOutgoingWebhooks  Boolean          @default(false)
  allowAiCopilot         Boolean          @default(false)
}

model CurrencyConfig {
  code                String   @id // SAR, AED, USD, KWD, EGP, EUR
  nameAr              String
  symbol              String   // ر.س, د.إ, $, ج.م
  exchangeRateToUSD   Float    // سعر الصرف مقابل الدولار
  isBaseCurrency      Boolean  @default(false)
  isActive            Boolean  @default(true)
  autoDetectCountries String[] // ["SA"], ["AE"], ["EG", "SD"]
  updatedAt           DateTime @updatedAt
}

model PromotionCoupon {
  id                  String    @id @default(cuid())
  code                String    @unique // مثلاً: SAUDI94, LAUNCH50
  descriptionAr       String?
  discountType        String    // PERCENTAGE | FIXED_AMOUNT
  discountValue       Float     // قيمة الخصم (مثلاً 20 لـ 20%، أو 50 ريال)
  maxUses             Int?      // أقصى عدد لاستخدام الكوبون إجمالاً
  usedCount           Int       @default(0)
  maxUsesPerUser      Int       @default(1)
  validFrom           DateTime  @default(now())
  validUntil          DateTime?
  isActive            Boolean   @default(true)
  applicablePlanSlugs String[]  // الباقات المسموح تطبيق الخصم عليها
  createdAt           DateTime  @default(now())
}

model UserSubscription {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id])
  status                String           @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, EXPIRED
  billingCycle          String           // MONTHLY, YEARLY, LIFETIME
  currency              String
  amountPaid            Float
  couponCode            String?
  gatewayCode           String           // mada, stripe, tamara
  gatewaySubscriptionId String?
  currentPeriodStart    DateTime         @default(now())
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([userId, status])
}

model FinancialInvoice {
  id             String    @id @default(cuid())
  invoiceNumber  String    @unique // INV-2026-0001
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?
  billingCycle   String?
  amountSubtotal Float
  discountAmount Float     @default(0.0)
  taxAmount      Float     @default(0.0) // ضريبة القيمة المضافة 15% (KSA)
  amountTotal    Float
  currency       String
  gatewayCode    String
  gatewayTxId    String?
  status         String    // PAID, FAILED, REFUNDED, PENDING
  pdfUrl         String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
}

model FinancialAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity, entityId])
}

model CreatorPayoutProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName        String
  bankCode        String   // e.g. "80" (Al Rajhi), "10" (SNB), "50" (Alinma)
  iban            String   // Full validated Saudi IBAN (SA...)
  beneficiaryName String
  isVerified      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PayoutRequest {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String    @default("SAR")
  status            String    @default("PENDING") // PENDING, APPROVED, TRANSFERRED, REJECTED
  transferReference String?
  rejectionReason   String?
  requestedAt       DateTime  @default(now())
  processedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
}

model UserTwoFactorAuth {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted      String    // AES-256-GCM encrypted base32 secret
  backupCodesEncrypted String    // AES-256-GCM encrypted JSON array of { codeHash, used, usedAt }
  isEnabled            Boolean   @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   // LOGIN, PASSWORD_CHANGE, 2FA_ENABLE, 2FA_DISABLE, SESSION_REVOKE, IBAN_UPDATE
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model CreatorSubscriber {
  id        String   @id @default(cuid())
  creatorId String
  email     String
  name      String?
  source    String?  @default("bio_page")
  status    String   @default("ACTIVE") // ACTIVE | UNSUBSCRIBED
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([creatorId, email])
  @@index([creatorId, createdAt])
  @@index([creatorId, status])
}

model NewsletterBroadcast {
  id         String   @id @default(cuid())
  creatorId  String
  subject    String
  content    String   @db.Text
  sentCount  Int      @default(0)
  status     String   @default("SENT") // SENT | DRAFT | FAILED
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
}

model DigitalProduct {
  id          String         @id @default(cuid())
  creatorId   String
  title       String
  description String?
  price       Float
  currency    String         @default("SAR")
  productType String         @default("DIGITAL") // DIGITAL | TIP
  fileUrl     String?
  isActive    Boolean        @default(true)
  salesCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      DigitalOrder[]

  @@index([creatorId, isActive])
}

model DigitalOrder {
  id          String         @id @default(cuid())
  productId   String
  product     DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  creatorId   String
  buyerEmail  String
  amount      Float
  currency    String         @default("SAR")
  status      String         @default("PAID")
  deliveryUrl String?
  createdAt   DateTime       @default(now())

  @@index([creatorId, createdAt])
  @@index([productId])
}

model OAuthProviderConfig {
  id                    String   @id @default(cuid())
  provider              String   @unique // "google" | "facebook" | "apple"
  displayNameAr         String
  isEnabled             Boolean  @default(false)
  clientId              String?
  clientSecretEncrypted String?
  extraConfig           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NfcCard {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardCode          String    @unique
  isEnabled         Boolean   @default(true)
  cardTitle         String
  cardSubtitle      String?
  material          String    @default("matte_black")
  orientation       String    @default("horizontal")
  accentColor       String    @default("#4edea3")
  customBgColor     String    @default("#111827")
  customTextColor   String    @default("#ffffff")
  cardShape         String    @default("rounded")
  cardPattern       String    @default("glow")
  showAvatar        Boolean   @default(true)
  showNfcIcon       Boolean   @default(true)
  showQrOnBack      Boolean   @default(true)
  showBarcodeOnBack Boolean   @default(true)
  targetMode        String    @default("BIO_PAGE") // BIO_PAGE | DIRECT_URL | VCARD
  customTargetUrl   String?
  vcardPhone        String?
  vcardEmail        String?
  vcardCompany      String?
  qrForeground      String    @default("#0f172a")
  qrBackground      String    @default("#ffffff")
  barcodeValue      String
  tapCount          Int       @default(0)
  qrScanCount       Int       @default(0)
  lastTappedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([cardCode])
}

enum NotificationType {
  ANNOUNCEMENT
  SUCCESS
  WARNING
  URGENT
  PROMO
  CUSTOM
}

enum NotificationTarget {
  ALL
  CREATORS_ONLY
  VISITORS_ONLY
  ADMINS_ONLY
}

enum NotificationPosition {
  BOTTOM_LEFT
  TOP_LEFT
  BOTTOM_CENTER
}

model SystemNotification {
  id                 String               @id @default(cuid())
  title              String
  message            String
  type               NotificationType     @default(ANNOUNCEMENT)
  color              String               @default("#6366f1")
  bgColor            String?
  icon               String?
  position           NotificationPosition @default(BOTTOM_LEFT)
  target             NotificationTarget   @default(ALL)
  actionLabel        String?
  actionUrl          String?
  isActive           Boolean              @default(true)
  priority           Int                  @default(0)
  autoDismissSeconds Int?                 @default(10)
  startsAt           DateTime             @default(now())
  expiresAt          DateTime?
  viewCount          Int                  @default(0)
  clickCount         Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([isActive, target, startsAt, expiresAt])
}

model ConsultationService {
  id              String               @id @default(cuid())
  creatorId       String
  creator         User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int                  @default(30)
  price           Float
  currency        String               @default("SAR")
  isActive        Boolean              @default(true)
  bookings        AppointmentBooking[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([creatorId, isActive])
}

model AvailabilityRule {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 (Sun) - 6 (Sat)
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  slotMinutes Int      @default(30)
  isActive    Boolean  @default(true)

  @@index([creatorId, dayOfWeek])
}

model AppointmentBooking {
  id          String              @id @default(cuid())
  serviceId   String
  service     ConsultationService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  clientName  String
  clientEmail String
  clientPhone String?
  startTime   DateTime
  endTime     DateTime
  status      String              @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | CANCELLED | EXPIRED
  lockedUntil DateTime?           // مهلة قفل الحجز المؤقت (10 دقائق)
  paymentId   String?             @unique
  meetingUrl  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([creatorId, startTime, endTime])
  @@index([status, lockedUntil])
}

model CreatorWebhookEndpoint {
  id              String          @id @default(cuid())
  creatorId       String
  creator         User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  url             String
  secretEncrypted String
  events          String[]        // ["order.completed", "lead.collected", "booking.confirmed"]
  isActive        Boolean         @default(true)
  deliveries      WebhookOutbox[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([creatorId, isActive])
}

model WebhookOutbox {
  id           String                 @id @default(cuid())
  endpointId   String
  endpoint     CreatorWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String                 @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts     Int                    @default(0)
  maxAttempts  Int                    @default(5)
  nextRetryAt  DateTime               @default(now())
  responseCode Int?
  lastError    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status, nextRetryAt])
}

model AffiliateCommissionLog {
  id               String    @id @default(cuid())
  referrerId       String
  referrer         User      @relation("ReferrerCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId   String
  referredUser     User      @relation("ReferredUserCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  subscriptionId   String
  invoiceId        String    @unique
  planSlug         String
  invoiceAmount    Float
  commissionRate   Float     @default(20.0) // 20%
  commissionAmount Float
  status           String    @default("ESCROW") // ESCROW | CLEARED | PAID
  escrowUntil      DateTime
  clearedAt        DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([referrerId, status])
  @@index([escrowUntil])
}






