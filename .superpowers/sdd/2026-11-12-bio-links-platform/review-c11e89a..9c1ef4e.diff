diff --git a/src/lib/tracking-service.ts b/src/lib/tracking-service.ts
new file mode 100644
index 0000000..f0ba5bb
--- /dev/null
+++ b/src/lib/tracking-service.ts
@@ -0,0 +1,71 @@
+import prisma from "./prisma";
+import { isBotOrPrefetch } from "./bot-detector";
+
+export function getNormalizedDate(date: Date = new Date()): Date {
+  const normalized = new Date(date);
+  normalized.setUTCHours(0, 0, 0, 0);
+  return normalized;
+}
+
+export function shouldCountClick(userAgent: string | null, headers: Headers): boolean {
+  return !isBotOrPrefetch(userAgent, headers);
+}
+
+export async function recordLinkClick(linkId: string, userAgent: string | null, headers: Headers) {
+  if (!shouldCountClick(userAgent, headers)) {
+    return;
+  }
+
+  const today = getNormalizedDate();
+
+  try {
+    await prisma.dailyLinkStat.upsert({
+      where: {
+        linkId_date: {
+          linkId,
+          date: today,
+        },
+      },
+      update: {
+        clicks: { increment: 1 },
+      },
+      create: {
+        linkId,
+        date: today,
+        clicks: 1,
+      },
+    });
+  } catch (error) {
+    console.error("Failed to record link click:", error);
+  }
+}
+
+export async function recordPageView(username: string, userAgent: string | null, headers: Headers) {
+  if (!shouldCountClick(userAgent, headers)) {
+    return;
+  }
+
+  const cleanUsername = username.toLowerCase().trim();
+  const today = getNormalizedDate();
+
+  try {
+    await prisma.dailyProfileStat.upsert({
+      where: {
+        username_date: {
+          username: cleanUsername,
+          date: today,
+        },
+      },
+      update: {
+        views: { increment: 1 },
+      },
+      create: {
+        username: cleanUsername,
+        date: today,
+        views: 1,
+      },
+    });
+  } catch (error) {
+    console.error("Failed to record page view:", error);
+  }
+}
diff --git a/src/lib/url-sanitizer.ts b/src/lib/url-sanitizer.ts
new file mode 100644
index 0000000..1568469
--- /dev/null
+++ b/src/lib/url-sanitizer.ts
@@ -0,0 +1,90 @@
+const BLOCKED_SHORTENERS = new Set([
+  "bit.ly",
+  "tinyurl.com",
+  "t.co",
+  "cutt.ly",
+  "is.gd",
+  "buff.ly",
+  "ow.ly",
+  "goo.gl",
+  "rebrand.ly",
+]);
+
+const IPV4_REGEX = /^(\d{1,3}\.){3}\d{1,3}$/;
+const IPV6_REGEX = /^\[?[a-fA-F0-9:]+\]?$/;
+
+export interface SanitizeUrlResult {
+  valid: boolean;
+  normalizedUrl?: string;
+  error?: string;
+}
+
+export function sanitizeUrl(rawUrl: string): SanitizeUrlResult {
+  if (!rawUrl || typeof rawUrl !== "string") {
+    return { valid: false, error: "الرابط مطلوب" };
+  }
+
+  let trimmed = rawUrl.trim();
+
+  // Block dangerous schemes immediately
+  const lower = trimmed.toLowerCase();
+  if (
+    lower.startsWith("javascript:") ||
+    lower.startsWith("data:") ||
+    lower.startsWith("vbscript:") ||
+    lower.startsWith("file:")
+  ) {
+    return { valid: false, error: "مخطط الرابط غير مسموح به لأسباب أمنية" };
+  }
+
+  // Prepend https:// if protocol is missing
+  if (!/^https?:\/\//i.test(trimmed)) {
+    trimmed = `https://${trimmed}`;
+  }
+
+  try {
+    const parsed = new URL(trimmed);
+
+    // Only allow http and https
+    if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+      return { valid: false, error: "يجب أن يبدأ الرابط بـ http أو https" };
+    }
+
+    const hostname = parsed.hostname.toLowerCase();
+
+    // Block localhost
+    if (hostname === "localhost" || hostname === "127.0.0.1" || hostname === "::1") {
+      return { valid: false, error: "لا يمكن استخدام روابط localhost" };
+    }
+
+    // Block raw IPv4 and IPv6
+    if (IPV4_REGEX.test(hostname) || (hostname.startsWith("[") && IPV6_REGEX.test(hostname))) {
+      return { valid: false, error: "لا يُسمح باستخدام عناوين IP المباشرة" };
+    }
+
+    // Block known double redirect shorteners
+    if (BLOCKED_SHORTENERS.has(hostname)) {
+      return { valid: false, error: "لا يُسمح باستخدام خدمات تقصير الروابط لمنع التصيد الاحتيالي" };
+    }
+
+    // Verify valid domain format (must contain at least one dot and valid characters)
+    if (!hostname.includes(".") || hostname.startsWith(".") || hostname.endsWith(".")) {
+      return { valid: false, error: "صيغة النطاق غير صالحة" };
+    }
+
+    // Clean normalized output: strip trailing slash only if original input did not have one and path is root
+    let normalized = parsed.toString();
+    if (parsed.pathname === "/" && !parsed.search && !parsed.hash) {
+      if (!trimmed.endsWith("/")) {
+        normalized = normalized.replace(/\/$/, "");
+      }
+    }
+
+    return {
+      valid: true,
+      normalizedUrl: normalized,
+    };
+  } catch {
+    return { valid: false, error: "صيغة الرابط غير صالحة" };
+  }
+}
