+                    (profile.borderRadius || "rounded-xl") === BORDER_RADIUS_MAP[radiusKey]
+                      ? "border-blue-600 bg-blue-50 text-blue-700"
+                      : "border-gray-200 hover:bg-gray-50 text-gray-700"
