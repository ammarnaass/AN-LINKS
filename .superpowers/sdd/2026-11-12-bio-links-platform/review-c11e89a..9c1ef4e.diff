@@ -0,0 +1,152 @@
+"use client";
+
+import React, { useState } from "react";
+import { Flag, X, AlertTriangle, CheckCircle } from "lucide-react";
+
+interface ReportModalProps {
+  username: string;
+}
+
+export function ReportModal({ username }: ReportModalProps) {
+  const [isOpen, setIsOpen] = useState(false);
+  const [reason, setReason] = useState("phishing");
+  const [details, setDetails] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [statusMessage, setStatusMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setIsSubmitting(true);
+    setStatusMessage(null);
+
+    try {
+      const res = await fetch("/api/reports", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          username,
+          reason,
+          details,
+        }),
+      });
+
+      const data = await res.json();
+      if (res.ok) {
+        setStatusMessage({ type: "success", text: data.message });
+        setTimeout(() => {
+          setIsOpen(false);
+          setStatusMessage(null);
+          setDetails("");
+        }, 2500);
+      } else {
+        setStatusMessage({ type: "error", text: data.error || "فشل إرسال البلاغ" });
+      }
+    } catch {
+      setStatusMessage({ type: "error", text: "حدث خطأ في الاتصال، يرجى المحاولة لاحقاً" });
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setIsOpen(true)}
+        className="inline-flex items-center gap-1.5 text-xs opacity-60 hover:opacity-100 transition text-gray-500 hover:text-red-500"
+        title="الإبلاغ عن هذه الصفحة"
+      >
+        <Flag className="w-3.5 h-3.5" />
+        <span>إبلاغ عن محتوى مخالف</span>
+      </button>
+
+      {isOpen && (
+        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm" dir="rtl">
+          <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 space-y-4 animate-in fade-in zoom-in duration-150">
+            <div className="flex items-center justify-between pb-3 border-b border-gray-100">
+              <div className="flex items-center gap-2 text-red-600">
+                <AlertTriangle className="w-5 h-5" />
+                <h3 className="font-bold text-gray-900 text-base">إبلاغ عن صفحة مخالفة</h3>
+              </div>
+              <button
+                type="button"
+                onClick={() => setIsOpen(false)}
+                className="text-gray-400 hover:text-gray-600 p-1 rounded-lg"
+              >
+                <X className="w-5 h-5" />
+              </button>
+            </div>
+
+            {statusMessage && (
+              <div
+                className={`p-3 rounded-xl text-xs flex items-center gap-2 ${
+                  statusMessage.type === "success"
+                    ? "bg-green-50 text-green-700 border border-green-200"
+                    : "bg-red-50 text-red-700 border border-red-200"
+                }`}
+              >
+                {statusMessage.type === "success" ? (
+                  <CheckCircle className="w-4 h-4 text-green-500 flex-shrink-0" />
+                ) : (
+                  <AlertTriangle className="w-4 h-4 text-red-500 flex-shrink-0" />
+                )}
+                <span>{statusMessage.text}</span>
+              </div>
+            )}
+
+            <form onSubmit={handleSubmit} className="space-y-4">
+              <div>
+                <label className="block text-xs font-semibold text-gray-700 mb-1">
+                  سبب البلاغ
+                </label>
+                <select
+                  value={reason}
+                  onChange={(e) => setReason(e.target.value)}
+                  className="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm outline-none focus:ring-2 focus:ring-red-500 bg-white"
+                >
+                  <option value="phishing">تصيد احتيالي أو روابط مشبوهة</option>
+                  <option value="malware">برمجيات ضارة أو فيروسات</option>
+                  <option value="inappropriate">محتوى غير لائق أو مخالف</option>
+                  <option value="impersonation">انتحال شخصية أو علامة تجارية</option>
+                  <option value="spam">إزعاج أو روابط مضللة</option>
+                  <option value="other">أسباب أخرى</option>
+                </select>
+              </div>
+
+              <div>
+                <label className="block text-xs font-semibold text-gray-700 mb-1">
+                  تفاصيل إضافية (اختياري)
+                </label>
+                <textarea
+                  rows={3}
+                  maxLength={500}
+                  value={details}
+                  onChange={(e) => setDetails(e.target.value)}
+                  placeholder="وضح سبب البلاغ لمساعدة فريق المراجعة..."
+                  className="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm outline-none focus:ring-2 focus:ring-red-500 resize-none"
+                />
+              </div>
+
+              <div className="flex items-center justify-end gap-2 pt-2">
+                <button
+                  type="button"
+                  onClick={() => setIsOpen(false)}
+                  className="px-4 py-2 text-xs font-semibold text-gray-600 hover:bg-gray-100 rounded-xl transition"
+                >
+                  إلغاء
+                </button>
+                <button
+                  type="submit"
+                  disabled={isSubmitting}
+                  className="px-5 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-semibold transition disabled:opacity-50"
+                >
+                  {isSubmitting ? "جاري الإرسال..." : "إرسال البلاغ"}
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
diff --git a/src/lib/analytics-service.ts b/src/lib/analytics-service.ts
new file mode 100644
index 0000000..0153ca9
--- /dev/null
+++ b/src/lib/analytics-service.ts
@@ -0,0 +1,134 @@
+import prisma from "./prisma";
+import { getNormalizedDate } from "./tracking-service";
+
+export interface TimeSeriesPoint {
+  date: string;
+  count: number;
+}
+
+export interface AnalyticsSummary {
+  rangeDays: number;
+  totalViews: number;
+  totalClicks: number;
+  ctr: number;
+  viewsSeries: TimeSeriesPoint[];
+  clicksSeries: TimeSeriesPoint[];
+  topLinks: { id: string; title: string; clicks: number }[];
+}
+
+export function calculateCTR(views: number, clicks: number): number {
+  if (!views || views <= 0) return 0.0;
+  return Math.round((clicks / views) * 1000) / 10;
+}
+
+export function generateDateRange(days: number): string[] {
+  const result: string[] = [];
+  const today = new Date();
+
+  for (let i = days - 1; i >= 0; i--) {
+    const d = new Date(today);
+    d.setDate(today.getDate() - i);
+    result.push(d.toISOString().split("T")[0]);
+  }
+
+  return result;
+}
+
+export function aggregateTimeSeries(
+  records: { date: string; count: number }[],
+  days: number
+): TimeSeriesPoint[] {
+  const dates = generateDateRange(days);
+  const recordMap = new Map<string, number>();
+
+  for (const r of records) {
+    recordMap.set(r.date, r.count);
+  }
+
+  return dates.map((date) => ({
+    date,
+    count: recordMap.get(date) || 0,
+  }));
+}
+
+export async function getProfileAnalytics(username: string, days: number = 7): Promise<AnalyticsSummary> {
+  const cleanUsername = username.toLowerCase().trim();
+  const startDate = new Date();
+  startDate.setDate(startDate.getDate() - days);
+  startDate.setUTCHours(0, 0, 0, 0);
+
+  // 1. Fetch Views
+  const viewsData = await prisma.dailyProfileStat.findMany({
+    where: {
+      username: cleanUsername,
+      date: { gte: startDate },
+    },
+    orderBy: { date: "asc" },
+  });
+
+  // 2. Fetch Clicks for User's Links
+  const user = await prisma.user.findUnique({
+    where: { username: cleanUsername },
+    select: {
+      links: {
+        select: {
+          id: true,
+          title: true,
+          stats: {
+            where: { date: { gte: startDate } },
+          },
+        },
+      },
+    },
+  });
+
+  const viewsFormatted = viewsData.map((v) => ({
+    date: v.date.toISOString().split("T")[0],
+    count: v.views,
+  }));
+
+  const viewsSeries = aggregateTimeSeries(viewsFormatted, days);
+  const totalViews = viewsSeries.reduce((acc, curr) => acc + curr.count, 0);
+
+  // Group clicks by date
+  const clicksByDateMap = new Map<string, number>();
+  const topLinksList: { id: string; title: string; clicks: number }[] = [];
+
+  if (user?.links) {
+    for (const link of user.links) {
+      let linkTotalClicks = 0;
+      for (const stat of link.stats) {
+        const dateStr = stat.date.toISOString().split("T")[0];
+        const existing = clicksByDateMap.get(dateStr) || 0;
+        clicksByDateMap.set(dateStr, existing + stat.clicks);
+        linkTotalClicks += stat.clicks;
+      }
+      topLinksList.push({
+        id: link.id,
+        title: link.title,
+        clicks: linkTotalClicks,
+      });
+    }
+  }
+
+  topLinksList.sort((a, b) => b.clicks - a.clicks);
+
+  const clicksFormatted = Array.from(clicksByDateMap.entries()).map(([date, count]) => ({
+    date,
+    count,
+  }));
+
+  const clicksSeries = aggregateTimeSeries(clicksFormatted, days);
+  const totalClicks = clicksSeries.reduce((acc, curr) => acc + curr.count, 0);
+  const ctr = calculateCTR(totalViews, totalClicks);
+
+  return {
+    rangeDays: days,
+    totalViews,
+    totalClicks,
+    ctr,
+    viewsSeries,
+    clicksSeries,
+    topLinks: topLinksList,
+  };
+}
