+/**
+ * 11. Create Coupon
+ * Creates a promotion coupon with uniqueness validation.
+ */
+export async function createAdminCoupon(
+  input: CreateCouponInput,
+  adminId: string
+): Promise<AdminCouponItem> {
+  const code = input.code.trim().toUpperCase();
+  if (!code) {
