+      badge: activeCoupons > 0 ? activeCoupons : undefined,
+    },
+    {
+      key: "transactions",
+      label: "المعاملات والفواتير",
+      icon: <Receipt className="w-4 h-4 shrink-0" />,
+      badge: totalInvoices > 0 ? totalInvoices : undefined,
